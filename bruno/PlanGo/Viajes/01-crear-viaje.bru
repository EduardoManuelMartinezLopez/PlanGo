meta {
  name: Crear viaje (con itinerario generado por IA)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/viajes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "destino_id": 1,
    "fecha_inicio": "2026-12-01",
    "fecha_fin": "2026-12-05",
    "presupuesto": 15000,
    "tipo_viaje": "aventura"
  }
}

assert {
  res.status: eq 200
}
