meta {
  name: Caso de error - crear destino sin ser agente/admin
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/destinos
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token_viajero}}
}

body:json {
  {
    "nombre": "Destino de prueba",
    "pais": "México",
    "precio_desde": 1000
  }
}

assert {
  res.status: eq 403
}
